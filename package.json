{
  "name": "dsh-notice",
  "version": "1.0.0",
  "description": "Windows system notifications when a DeepSeek Harness session needs your approval, an answer, or has completed a turn",
  "license": "MIT",
  "type": "module",
  "author": "EjectButton444",
  "homepage": "https://github.com/EjectButton444/dsh-notice",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EjectButton444/dsh-notice.git"
  },
  "bugs": {
    "url": "https://github.com/EjectButton444/dsh-notice/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek",
    "deepseek-harness",
    "notifications",
    "windows",
    "toast",
    "plugin-market"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.engine.js",
    "focus.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check": "node --check index.js && node --check client.js && node --check client.engine.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
